managed implementation in class ZBP_R_DBEMBARAZO_03 unique;
strict ( 2 );
with draft;
extensible;
define behavior for ZR_DBEMBARAZO_03 alias ZrDbembarazo03
persistent table ZDBEMBARAZO_03
extensible
draft table ZDBEMBARAZO_03_D
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master( global )
{
  field ( mandatory : create )
   IdSeguimiento,
   NombrePaciente;

  field ( readonly )
   CreatedBy,
   CreatedAt,
   LastChangedBy,
   LocalLastChangedAt,
   LastChangedAt,
   FechaProbableParto;

  field ( readonly : update )
   IdSeguimiento,
   NombrePaciente,
   Estado;

  create;
  update;
  delete;

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for ZDBEMBARAZO_03 corresponding extensible
  {
    IdSeguimiento = ID_SEGUIMIENTO;
    NombrePaciente = NOMBRE_PACIENTE;
    FechaUltimaRegla = FECHA_ULTIMA_REGLA;
    FechaProbableParto = FECHA_PROBABLE_PARTO;
    SemanaGestacion = SEMANA_GESTACION;
    GrupoSanguineo = GRUPO_SANGUINEO;
    FactorRh = FACTOR_RH;
    NivelRiesgo = NIVEL_RIESGO;
    Estado = ESTADO;
    PesoActual = PESO_ACTUAL;
    UnidadPeso = UNIDAD_PESO;
    ProximaRevision = PROXIMA_REVISION;
    Observaciones = OBSERVACIONES;
    CreatedBy = CREATED_BY;
    CreatedAt = CREATED_AT;
    LastChangedBy = LAST_CHANGED_BY;
    LocalLastChangedAt = LOCAL_LAST_CHANGED_AT;
    LastChangedAt = LAST_CHANGED_AT;
  }

  determination calcularFechaParto on modify { field FechaUltimaRegla; }

}