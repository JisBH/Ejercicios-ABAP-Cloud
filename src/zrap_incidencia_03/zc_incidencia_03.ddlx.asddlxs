@Metadata.layer: #CORE

// Cabecera: Título principal = Titulo, Descripción = IdIncidencia
@UI.headerInfo: {
  typeName: 'Incidencia',
  typeNamePlural: 'Incidencias',
  title: { type: #STANDARD, value: 'Titulo' },
  description: { type: #STANDARD, value: 'IdIncidencia' }
}

// Ordenación por defecto: Prioridad y luego Fecha límite
@UI.presentationVariant: [{
  sortOrder: [
    { by: 'Prioridad', direction: #DESC },
    { by: 'FechaLimite', direction: #ASC }
  ]
}]

annotate view ZC_INCIDENCIA_03 with
{
  // --- DEFINICIÓN DE LAS 2 SECCIONES EN DETALLE ---
  @UI.facet: [ 
    {
      id: 'GeneralInfo', 
      label: 'Información general', 
      purpose: #STANDARD, 
      type: #IDENTIFICATION_REFERENCE, 
      position: 10 
    },
    {
      id: 'FechasSection', 
      label: 'Fechas', 
      purpose: #STANDARD, 
      type: #FIELDGROUP_REFERENCE, 
      targetQualifier: 'GrupoFechas', 
      position: 20 
    }
  ]

  // --- SECCIÓN INFORMACIÓN GENERAL ---

  @EndUserText.label: 'Identificador'
  @UI.lineItem: [ { position: 10, label: 'Identificador' } ]
  @UI.selectionField: [ { position: 10 } ]
  @UI.identification: [ { position: 10, label: 'Identificador' } ]
  IdIncidencia;
  
  @EndUserText.label: 'Título'
  @UI.lineItem: [ { position: 20, label: 'Título' } ]
  @UI.selectionField: [ { position: 20 } ]
  @UI.identification: [ { position: 20, label: 'Título' } ]
  Titulo;
  
  @EndUserText.label: 'Descripción'
  @UI.identification: [ { position: 30, label: 'Descripción' } ]
  Descripcion;
  
  @EndUserText.label: 'Categoría'
  @UI.lineItem: [ { position: 30, label: 'Categoría' } ]
  @UI.selectionField: [ { position: 30 } ]
  @UI.identification: [ { position: 40, label: 'Categoría' } ]
  Categoria;
  
  @EndUserText.label: 'Prioridad'
  @UI.lineItem: [ { position: 40, label: 'Prioridad' } ]
  @UI.selectionField: [ { position: 40 } ]
  @UI.identification: [ { position: 50, label: 'Prioridad' } ]
  Prioridad;
  
  @EndUserText.label: 'Estado'
  @UI.lineItem: [ { position: 50, label: 'Estado' } ]
  @UI.selectionField: [ { position: 50 } ]
  @UI.identification: [ { position: 60, label: 'Estado' } ]
  Estado;
  
  @EndUserText.label: 'Responsable'
  @UI.lineItem: [ { position: 60, label: 'Responsable' } ]
  @UI.selectionField: [ { position: 60 } ]
  @UI.identification: [ { position: 70, label: 'Responsable' } ]
  Responsable;
  
  // --- SECCIÓN FECHAS (Vinculadas con targetQualifier: 'GrupoFechas') ---

  @EndUserText.label: 'Fecha de alta'
  @UI.fieldGroup: [ { qualifier: 'GrupoFechas', position: 10, label: 'Fecha de alta' } ]
  FechaAlta;
  
  @EndUserText.label: 'Fecha límite'
  @UI.lineItem: [ { position: 70, label: 'Fecha límite' } ]
  @UI.fieldGroup: [ { qualifier: 'GrupoFechas', position: 20, label: 'Fecha límite' } ]
  FechaLimite;
  
  @EndUserText.label: 'Fecha de cierre'
  @UI.fieldGroup: [ { qualifier: 'GrupoFechas', position: 30, label: 'Fecha de cierre' } ]
  FechaCierre;
  
  
}