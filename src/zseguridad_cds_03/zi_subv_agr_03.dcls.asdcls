@EndUserText.label: 'Control de acceso para subvenciones'
@MappingRole: true
define role ZI_SUBV_AGR_03 {
    grant
        select
            on
                ZI_SUBV_AGR_03
                    where
                        ( Comarca ) =
        aspect pfcg_auth(
          ZSUBVAGR03,
          ZCOMARCA03, 
          ACTVT = '03'
        );
                        
}